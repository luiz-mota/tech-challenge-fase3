# Copiar para .env e preencher com valores reais (NUNCA commitar o .env)

# Caminho local para a chave JSON da service account (FORA do repositório)
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/<usuario>/gcp/tech-challenge-sa.json

# Projeto de faturamento das queries no BigQuery
GCP_PROJECT_ID=tech-challenge-fase2-501722

# Dataset Gold construído no Tech Challenge da Fase 2
GOLD_DATASET=gold

# Projeto público da Base dos Dados (origem dos microdados)
BASEDOSDADOS_PROJECT=basedosdados
